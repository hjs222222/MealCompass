# ============================================================
# 环境变量模板：复制为 .env 后填入真实值
#   cp .env.example .env
# .env 已在 .gitignore 中，密钥绝不入库
# ============================================================

# ===== 应用 =====
APP_ENV=dev                       # dev / staging / prod
LOG_LEVEL=INFO

# ===== LLM（OpenAI 兼容接口）=====
LLM_API_KEY=sk-xxx                # 必填：DeepSeek 或其它 OpenAI 兼容 key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 检索模型 =====
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Langfuse（可观测；留空则自动降级为本地日志，不阻塞开发）=====
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com   # EU: cloud.langfuse.com / US: us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=dev                  # dev / staging / production

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://mealcompass:mealcompass@localhost:5432/mealcompass
REDIS_URL=redis://localhost:6379/0

# ===== 安全 =====
JWT_SECRET=change-me-in-dev-only
